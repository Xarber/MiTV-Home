{
  "name": "aurea-home",
  "version": "2.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/expo/pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/expo/*.test.ts",
    "test:e2e": "playwright test",
    "test:pwa": "node scripts/expo/verify-pwa-update.mjs",
    "android:tv": "./gradlew :app:assembleRelease",
    "android:remote": "python3 scripts/phone/prepare.py && cd .phone-native && AUREA_TARGET=remote npx expo run:android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-linear-gradient": "~58.0.3",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.0-0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
