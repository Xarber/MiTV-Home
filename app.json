{
  "expo": {
    "name": "Aurea Home",
    "slug": "aurea-home",
    "version": "2.0.1",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Aurea Home · Interactive demo",
      "favicon": "./public/branding/icon-192.png"
    },
    "android": {
      "package": "it.xarber.mitvhome",
      "versionCode": 27
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "scheme": "aurea",
    "ios": {
      "bundleIdentifier": "it.xarber.aurea.remote",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your television on home Wi-Fi to control Aurea Home.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "27"
    },
    "icon": "./public/branding/icon-1024.png"
  }
}
